{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parent-dashboard",
  "compatibility_date": "2026-01-01",
  // Keep the workers.dev URL live alongside the custom domain below —
  // testers may have it bookmarked.
  "workers_dev": true,
  // Serve the built Vite output as static assets, with SPA fallback so
  // client-side routes like /login and /privacy resolve to index.html.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  // Custom domain — novapath.care lives in the same Cloudflare account
  // (bought through the Cloudflare registrar), so this just needs a deploy
  // to provision the route + TLS cert. workers.dev stays live alongside it.
  "routes": [
    { "pattern": "novapath.care", "custom_domain": true },
    { "pattern": "www.novapath.care", "custom_domain": true }
  ]
}
