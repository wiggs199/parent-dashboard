# Python / backend
venv/
__pycache__/
*.py[cod]
*.sqlite3

# Secrets: ignore .env everywhere, but the frontend .env holds only a
# non-secret API URL and is committed so the app runs out of the box.
.env
.env.local
!parent-dashboard-frontend/.env

# Node / frontend
node_modules/
dist/
dist-ssr/
*.local

# Uploads (keep the folder, ignore contents)
parent-dashboard-backend/uploads/*
!parent-dashboard-backend/uploads/.gitkeep

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
