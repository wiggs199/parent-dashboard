# Copy to .env and fill in. .env is gitignored.

# development | production
ENV=development

# Required once ENV != development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database. Leave unset for local SQLite (db.sqlite3).
# In production set the Postgres connection string, e.g. from Neon:
#   DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
DATABASE_URL=

# How long an access token stays valid (minutes). Default 1440 = 24h.
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated browser origins allowed to call the API.
# Production: https://parent-dashboard.wiggs199.workers.dev
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the frontend lives — used to build links in emails.
# Production: https://parent-dashboard.wiggs199.workers.dev
FRONTEND_URL=http://localhost:5173

# Transactional email (Resend). Leave blank locally — emails are then
# logged (with their links) instead of sent.
RESEND_API_KEY=
EMAIL_FROM=NovaPath <onboarding@resend.dev>

# Document storage — Cloudflare R2 (S3-compatible). All four blank -> files
# are written to ./uploads locally (dev and tests).
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Error monitoring — Sentry DSN. Blank = disabled (dev, tests).
SENTRY_DSN=
